## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Logs
logs/
*.log

# Database
*.db
*.db-shm
*.db-wal

# JetBrains Rider
.idea/
*.sln.iml

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# appsettings
appsettings.Development.json
appsettings.Production.json

# Link BE nhap luc chay start-kiosk.bat
be-url.txt
kiosk-secret.txt
kiosk-identity.txt

# Local water bench evidence and operator configuration
water-bench-spool/
