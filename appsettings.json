{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CrabSenseDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kiosk": {
    "UseHttpsRedirection": false,
    "UseLocalDatabase": false,
    "DataPath": "/var/lib/crabsense-kiosk/kiosk.db"
  },
  "EdgeGateway": {
    "BackendUrl": "",
    "ApiKey": "",
    "PollIntervalSeconds": 2,
    "TelemetryForwardIntervalSeconds": 2
  },
  "WaterQuality": {
    "SafeRanges": {
      "Temperature": {
        "Min": 20,
        "Max": 30
      },
      "pH": {
        "Min": 7.0,
        "Max": 8.5
      },
      "DissolvedOxygen": {
        "Min": 5.0,
        "Max": 10.0
      },
      "Salinity": {
        "Min": 25,
        "Max": 35
      }
    }
  }
}
