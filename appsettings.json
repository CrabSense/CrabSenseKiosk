{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CrabSenseDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kiosk": {
    "UseHttpsRedirection": false
  },
  "EdgeGateway": {
    "BackendUrl": "http://103.69.96.143:5080",
    "ApiKey": "crabsense-edge-dev-key",
    "PollIntervalSeconds": 2,
    "TelemetryForwardIntervalSeconds": 2
  },
  "WaterQuality": {
    "SafeRanges": {
      "Temperature": {
        "Min": 20,
        "Max": 30
      },
      "pH": {
        "Min": 7,
        "Max": 8.5
      },
      "DissolvedOxygen": {
        "Min": 5,
        "Max": 10
      },
      "Salinity": {
        "Min": 25,
        "Max": 35
      }
    }
  },
  "WaterBench": {
    "Enabled": false,
    "EnableSupervisedControl": false,
    "UseBackendSchedule": false,
    "EnableBatchSync": false,
    "EnableMediaSync": false,
    "BackendStationId": "00000000-0000-0000-0000-000000000000",
    "MasterPort": "",
    "SlavePort": "",
    "MasterHardwareId": "",
    "SlaveHardwareId": "",
    "EvidenceDirectory": "water-bench-spool",
    "MaxSpoolBytes": 268435456,
    "MaxSpoolFiles": 20000
  }
}
